# =====================================================================
#  FSO marketing site — Apache / cPanel configuration
#  Place this file at the web root (public_html) of fsoworld.com
# =====================================================================

# ---- Force HTTPS and canonical www host ----
RewriteEngine On
# HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# non-www -> www  (comment this block out if you prefer the bare domain)
RewriteCond %{HTTP_HOST} ^fsoworld\.com$ [NC]
RewriteRule ^ https://www.fsoworld.com%{REQUEST_URI} [L,R=301]

# ---- Pretty URLs: /about -> /about.html ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- Custom 404 ----
ErrorDocument 404 /404.html

# ---- Never serve source / build / doc files publicly ----
<FilesMatch "\.(py|md|gs)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/integrations/

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
